# ==========================================================
# Variables de entorno para ms-andesstay-users (Docker Desktop)
# Copia este archivo a .env y ajusta los valores necesarios
# ==========================================================

# Base de datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AWS Cognito (mismo User Pool que BFF, catalog, reservations y audit)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_l3aNhIuac
COGNITO_APP_CLIENT_ID=CHANGE_ME

# false = solo base local (por defecto, recomendado en AWS Academy sin permisos IAM admin).
# true = crea usuarios y sincroniza grupos directamente en Cognito
COGNITO_ADMIN_ENABLED=false
# Solo si COGNITO_ADMIN_ENABLED=true y NO corre en AWS con rol IAM:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Primer administrador (opcional): email que ya pertenece al grupo ADMIN de Cognito
USERS_BOOTSTRAP_ADMIN_EMAIL=

# Origen permitido para CORS (Frontend Angular)
FRONTEND_URL=http://localhost:4200
CORS_ENABLED=true

# Apache Kafka compartido (red andesstay-net con 2 brokers)
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29093
KAFKA_TOPIC_USERS_EVENTS=users.events
KAFKA_TOPIC_REPLICATION_FACTOR=2
