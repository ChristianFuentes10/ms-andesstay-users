# ==========================================================
# Variables de entorno para ms-andesstay-users
# Copia este archivo a .env y ajusta los valores necesarios
# ==========================================================

# Base de datos PostgreSQL (puerto host 5435 para no colisionar con 5432/5433)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AWS Cognito (User Pool AndesStay compartido)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_l3aNhIuac
COGNITO_APP_CLIENT_ID=andesstay-web

# false = solo base local (recomendado en desarrollo / AWS Academy lab sin permisos IAM).
# true = sincroniza grupos y altas en Cognito (requiere permisos IAM cognito-idp:Admin*)
COGNITO_ADMIN_ENABLED=false
# Credenciales IAM solo si COGNITO_ADMIN_ENABLED=true y no se ejecuta con rol IAM:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Primer administrador (opcional): email que ya pertenece al grupo ADMIN de Cognito
USERS_BOOTSTRAP_ADMIN_EMAIL=

# Origen permitido para CORS (Frontend Angular)
FRONTEND_URL=http://localhost:4200
CORS_ENABLED=true

# Apache Kafka compartido (cluster de 2 brokers)
# Dentro de la red Docker andesstay-net: kafka-1:29092,kafka-2:29093
# Desde el host local: localhost:9092,localhost:9093
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29093
KAFKA_TOPIC_REPORTERIA=users.events
KAFKA_CONSUMER_GROUP_ID=users-events-group
KAFKA_TOPIC_REPLICATION_FACTOR=2
